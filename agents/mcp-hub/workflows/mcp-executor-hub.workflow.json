                                       -560,
                                       200
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const input = $(\u0027When Executed by Orchestrator\u0027).first().json || {};\r\nconst records = $input.all().map((item) =\u003e item.json || {});\r\nconst userGroups = input.user_authorized_groups;\r\nif (!Array.isArray(userGroups) || userGroups.some((group) =\u003e typeof group !== \u0027string\u0027)) throw new Error(\u0027Missing verified Entra groups; access denied\u0027);\r\nif (String(input.server_id || \u0027\u0027).trim().toLowerCase() !== \u0027jems\u0027) throw new Error(\u0027Only JEMS is configured\u0027);\r\nconst toolName = String(input.tool_name || \u0027\u0027).trim();\r\nif (!toolName) throw new Error(\u0027tool_name is required\u0027);\r\nconst parse = (value) =\u003e typeof value === \u0027string\u0027 ? JSON.parse(value) : value;\r\nconst configuredGroups = parse(String($env.MCP_HUB_JEMS_REQUIRED_GROUP_IDS || \u0027[]\u0027));\r\nif (!Array.isArray(configuredGroups) || configuredGroups.length === 0) throw new Error(\u0027JEMS access groups are not configured\u0027);\r\nconst userHasConfiguredAccess = configuredGroups.some((allowed) =\u003e userGroups.some((group) =\u003e group.toLowerCase() === String(allowed).toLowerCase()));\r\nif (!userHasConfiguredAccess) throw new Error(\u0027JEMS MCP access denied\u0027);\r\nconst row = records.find((record) =\u003e String(record.mcp_id || \u0027\u0027).toLowerCase() === \u0027jems\u0027 \u0026\u0026 String(record.tool_name || \u0027\u0027) === toolName \u0026\u0026 record.enabled !== false);\r\nif (!row) throw new Error(\u0027JEMS MCP function is not in the current registry\u0027);\r\nconst rowGroups = parse(row.required_group_ids || \u0027[]\u0027);\r\nif (!Array.isArray(rowGroups) || !rowGroups.some((required) =\u003e userGroups.some((group) =\u003e group.toLowerCase() === String(required).toLowerCase()))) throw new Error(\u0027JEMS function access denied\u0027);\r\nconst schema = parse(row.input_schema || \u0027{}\u0027);\r\nif (!schema || typeof schema !== \u0027object\u0027 || Array.isArray(schema)) throw new Error(\u0027Invalid registered MCP input schema\u0027);\r\nconst args = input.arguments \u0026\u0026 typeof input.arguments === \u0027object\u0027 \u0026\u0026 !Array.isArray(input.arguments) ? input.arguments : {};\r\nfor (const key of schema.required || []) if (!Object.prototype.hasOwnProperty.call(args, key)) throw new Error(\u0027Missing required tool argument: \u0027 + key);\r\nif (schema.additionalProperties === false) for (const key of Object.keys(args)) if (!Object.prototype.hasOwnProperty.call(schema.properties || {}, key)) throw new Error(\u0027Unknown tool argument: \u0027 + key);\r\nreturn [{ json: { server_id: \u0027jems\u0027, tool_name: toolName, arguments: args } }];"
                                     },
