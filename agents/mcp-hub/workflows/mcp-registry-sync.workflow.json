                      "id":  "McpRegistryJemsList",
                      "name":  "Fetch JEMS MCP functions",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "credentials":  {
                                          "httpMultipleHeadersAuth":  {
                                                                          "id":  "00000000-0000-4000-8000-000000000222",
                                                                          "name":  "JEMS MCP Auth"
                                                                      }
                                      },
                      "position":  [
                                       -280,
                                       200
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const response = $json || {};\r\nconst raw = response.body || response;\r\nconst headers = response.headers || {};\r\nconst contentType = String(Object.entries(headers).find(([key]) =\u003e key.toLowerCase() === \u0027content-type\u0027)?.[1] || \u0027\u0027).toLowerCase();\r\nlet message;\r\nif (typeof raw === \u0027string\u0027) {\r\n  if (contentType.includes(\u0027text/event-stream\u0027)) {\r\n    const data = raw.split(/\\r?\\n/).filter((line) =\u003e line.startsWith(\u0027data:\u0027)).map((line) =\u003e line.slice(5).trim()).filter(Boolean);\r\n    if (!data.length) throw new Error(\u0027JEMS MCP tools/list stream is empty\u0027);\r\n    message = JSON.parse(data[data.length - 1]);\r\n  } else message = JSON.parse(raw);\r\n} else message = raw;\r\nconst tools = message?.result?.tools;\r\nif (message?.error || !Array.isArray(tools)) throw new Error(\u0027JEMS MCP tools/list response is invalid\u0027);\r\nlet groups;\r\ntry { groups = JSON.parse(String($env.MCP_HUB_JEMS_REQUIRED_GROUP_IDS || \u0027[]\u0027)); } catch { throw new Error(\u0027MCP_HUB_JEMS_REQUIRED_GROUP_IDS must be a JSON array\u0027); }\r\nif (!Array.isArray(groups) || groups.length === 0) throw new Error(\u0027JEMS MCP access groups are not configured\u0027);\r\nreturn tools.filter((tool) =\u003e tool \u0026\u0026 typeof tool.name === \u0027string\u0027 \u0026\u0026 tool.name.trim()).map((tool) =\u003e ({ json: {\r\n  mcp_id: \u0027jems\u0027, server_name: \u0027JEMS MCP\u0027, tool_name: tool.name,\r\n  description: String(tool.description || \u0027\u0027),\r\n  input_schema: JSON.stringify(tool.inputSchema || { type: \u0027object\u0027, properties: {} }),\r\n  required_group_ids: JSON.stringify(groups), public: false, enabled: true,\r\n  synced_at: new Date().toISOString(),\r\n} }));"
                                     },
