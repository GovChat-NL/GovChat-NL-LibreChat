                                         "genericAuthType":  "httpMultipleHeadersAuth",
                                         "sendHeaders":  true,
                                         "headerParameters":  {
                                                                  "parameters":  [
                                                                                     {
                                                                                         "name":  "Accept",
                                                                                         "value":  "application/json, text/event-stream"
                                                                                     },
                                                                                     {
                                                                                         "name":  "mcp-session-id",
                                                                                         "value":  "={{ Object.entries($(\u0027Initialize JEMS MCP session\u0027).first().json.headers || {}).find(([key]) =\u003e key.toLowerCase() === \u0027mcp-session-id\u0027)?.[1] || \u0027\u0027 }}"
